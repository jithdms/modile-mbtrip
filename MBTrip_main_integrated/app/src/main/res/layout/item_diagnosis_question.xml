<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/diagnosis_card_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/questionNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Q1 · 계획성"
        android:textColor="#555555"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/questionPrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="3dp"
        android:text="질문 내용"
        android:textColor="#171717"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/answerJ"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/diagnosis_answer_unselected"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:text="J 선택지"
        android:textColor="#333333"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/answerBalanced"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:background="@drawable/diagnosis_answer_unselected"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:text="중간 선택지"
        android:textColor="#333333"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/answerP"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:background="@drawable/diagnosis_answer_unselected"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:text="P 선택지"
        android:textColor="#333333"
        android:textSize="14sp" />
</LinearLayout>
