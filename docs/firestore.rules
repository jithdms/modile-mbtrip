rules_version = '2';
// MBTrip Firestore 보안 규칙 (개발 단계용)
// Firebase Console → Firestore Database → 규칙 탭에 그대로 붙여 넣고 [게시].
// 익명 로그인도 request.auth 가 있으므로, 앱을 처음 켠 사람도 여행을 만들 수 있다.
service cloud.firestore {
  match /databases/{database}/documents {

    // 사용자 프로필 — 로그인한 사람은 읽기 가능(친구 검색 · 아이디로 로그인), 쓰기는 본인만
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;

      // 내 여행 목록 — 본인만
      match /myTrips/{tripId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // 친구 목록 — 본인은 읽기·쓰기, 친구 추가·삭제 때는 상대가 '자기 문서'(friends/{상대 uid})만 넣고 뺄 수 있다
      match /friends/{friendId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null && (request.auth.uid == uid || request.auth.uid == friendId);
      }
    }

    // 여행 방 · 동행자 · 일정 블록 · 투표 · 댓글 · 후기 · 지금 보는 사람(presence) — 로그인한 사람
    // (배포 전에는 "그 여행의 members 에 내가 있을 때만" 으로 좁히는 것을 권장)
    match /trips/{tripId} {
      allow read, write: if request.auth != null;
      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
