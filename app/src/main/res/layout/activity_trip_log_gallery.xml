<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp">

    <!-- 상단 검색바 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:background="#F5F5F5"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="16dp">

        <!-- 검색어 입력창 -->
        <EditText
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="검색어 입력"
            android:textSize="16sp"
            android:textColor="#333333"
            android:textColorHint="#999999"
            android:inputType="text" />

        <!-- 검색 아이콘 -->
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_search"
            android:contentDescription="검색" />
    </LinearLayout>

    <!-- 사진 그리드 영역 (스크롤뷰) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <!-- 좌우 2개 열로 나누어 지그재그 배치 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- [왼쪽 컬럼] 사진 3장 배치 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginRight="6dp">

                <!-- 왼쪽 1번 사진 -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/rounded_image"
                    android:clipToOutline="true"
                    android:src="@drawable/travel_main_photo"
                    android:layout_marginBottom="12dp"
                    android:contentDescription="왼쪽 사진 1" />

                <!-- 왼쪽 2번 사진 -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/rounded_image"
                    android:clipToOutline="true"
                    android:src="@drawable/travel_main_photo"
                    android:layout_marginBottom="12dp"
                    android:contentDescription="왼쪽 사진 2" />

                <!-- 왼쪽 3번 사진 -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/rounded_image"
                    android:clipToOutline="true"
                    android:src="@drawable/photo2"
                    android:layout_marginBottom="12dp"
                    android:contentDescription="왼쪽 사진 3" />
            </LinearLayout>

            <!-- [오른쪽 컬럼] 사진 2장 배치 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginLeft="6dp">

                <!-- 오른쪽 1번 사진 -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/rounded_image"
                    android:clipToOutline="true"
                    android:src="@drawable/photo1"
                    android:layout_marginBottom="12dp"
                    android:contentDescription="오른쪽 사진 1" />

                <!-- 오른쪽 2번 사진 -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="230dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/rounded_image"
                    android:clipToOutline="true"
                    android:src="@drawable/photo2"
                    android:layout_marginBottom="12dp"
                    android:contentDescription="오른쪽 사진 2" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>