<?xml version="1.0" encoding="utf-8"?>
<!--
    여행 모임 로그 — 사진 모아보기 (로그 목록)
    화면 묶기: triplog/TripLogGalleryBinder.kt · 데이터: triplog/TripLogRepository.kt
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/log_bg"
    android:orientation="vertical">

    <!-- 0. 상단 바: 뒤로 가기 + 제목 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_log_icon_button"
            android:contentDescription="뒤로 가기"
            android:src="@drawable/ic_log_back"
            android:tint="@color/log_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:letterSpacing="-0.02"
            android:text="여행 로그"
            android:textColor="@color/log_text"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 1. 검색창 + 오른쪽 달력 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_log_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="6dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_log_search"
                android:tint="@color/log_text_sub" />

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="제목, 내용, 장소로 검색"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/log_text"
                android:textColorHint="@color/log_text_hint"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/btn_clear_search"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_log_icon_button"
                android:contentDescription="검색어 지우기"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_log_close"
                android:tint="@color/log_text_sub"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_calendar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_log_square_button"
            android:contentDescription="기간 선택"
            android:src="@drawable/ic_log_calendar"
            android:tint="@color/log_text" />
    </LinearLayout>

    <!-- 2. 고른 기간 (달력에서 고르면 나타남, ✕ 로 해제) -->
    <LinearLayout
        android:id="@+id/chip_period"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_log_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_log_calendar"
            android:tint="@color/log_primary" />

        <TextView
            android:id="@+id/tv_period"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/log_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="2026.04.01 – 04.30" />

        <ImageButton
            android:id="@+id/btn_clear_period"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_log_icon_button"
            android:contentDescription="기간 해제"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_log_close"
            android:tint="@color/log_primary" />
    </LinearLayout>

    <!-- 3. 요약 줄 (로그 n개 · 사진 m장) + 예시일 때 DB 저장 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <TextView
            android:id="@+id/tv_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/log_text_sub"
            android:textSize="13sp"
            tools:text="로그 4개 · 사진 11장" />

        <TextView
            android:id="@+id/btn_summary_action"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_log_chip"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="내 로그로 추가"
            android:textColor="@color/log_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- 4. 사진 그리드 — 두 줄로 엇갈리며, 사진이 많으면 아래로 계속 이어진다 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_photos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="11dp"
            android:paddingTop="4dp"
            android:paddingEnd="11dp"
            android:paddingBottom="28dp"
            android:scrollbars="none"
            tools:listitem="@layout/item_trip_log_photo" />

        <!-- 비었을 때 · 못 불러왔을 때 -->
        <LinearLayout
            android:id="@+id/layout_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="40dp"
            android:paddingBottom="56dp"
            android:visibility="gone"
            tools:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/diagnosis_hero_badge"
                android:importantForAccessibility="no"
                android:padding="16dp"
                android:src="@drawable/ic_log_photos"
                android:tint="@color/mb_aqua_700" />

            <TextView
                android:id="@+id/tv_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="@color/log_text"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="아직 남긴 로그가 없어요" />

            <TextView
                android:id="@+id/tv_empty_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/log_text_sub"
                android:textSize="14sp"
                tools:text="여행 후기를 남기면 사진이 여기에 모여요." />

            <TextView
                android:id="@+id/btn_empty_primary"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_log_button_primary"
                android:gravity="center"
                android:minWidth="180dp"
                android:paddingHorizontal="20dp"
                android:textColor="@color/log_text"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="예시 로그 만들기" />

            <TextView
                android:id="@+id/btn_empty_secondary"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_log_button_secondary"
                android:gravity="center"
                android:minWidth="180dp"
                android:paddingHorizontal="20dp"
                android:textColor="@color/log_text"
                android:textSize="15sp"
                tools:text="예시로 보기" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/log_primary"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
