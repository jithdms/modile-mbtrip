<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <!-- 1. 상단 검색바 영역 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="검색어 입력"
                android:textColorHint="#9E9E9E"
                android:textSize="16sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/bg_search_bar"
                android:inputType="text" />

            <ImageView
                android:id="@+id/iv_search_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="12dp"
                android:src="@android:drawable/ic_menu_search"
                android:tint="#000000" />
        </LinearLayout>

        <!-- 구분선 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="16dp" />

        <!-- 2. 메인 이미지 (파란색 테두리 + 둥근 모서리) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="280dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/iv_travel_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/travel_main_photo" />
        </androidx.cardview.widget.CardView>

        <!-- 3. 날짜 표시 배지 -->
        <TextView
            android:id="@+id/tv_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2026.04.11~2026.04.13"
            android:textColor="#333333"
            android:textSize="15sp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="6dp"
            android:background="@drawable/bg_date_badge"
            android:layout_marginBottom="12dp" />

        <!-- 4. 별점 영역 (★★☆☆☆) -->
        <RatingBar
            android:id="@+id/rating_bar"
            style="?android:attr/ratingBarStyleIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:rating="2"
            android:stepSize="1"
            android:progressTint="#000000"
            android:secondaryProgressTint="#000000"
            android:layout_marginBottom="16dp" />

        <!-- 5. 제목 -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="멋있는 제목"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- 6. 본문 내용 -->
        <TextView
            android:id="@+id/tv_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="빡빡한 일정 대신 자연 속에서 걷고\n쉬는 것에 집중했던 여행. 복잡한 일상에서\n벗어나 재충전하기에 완벽한 2박 3일이었습니다.\n다음에는 서쪽 해안을 따라 렌터카 여행을 해보고\n싶네요!"
            android:textColor="#333333"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="16dp" />

        <!-- 7. 하단 우측 프로필 아이콘 3개 (user1, user2, user3 적용) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <!-- 첫 번째 프로필 (user1) -->
            <androidx.cardview.widget.CardView
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                android:layout_marginEnd="6dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/user1" />
            </androidx.cardview.widget.CardView>

            <!-- 두 번째 프로필 (user2) -->
            <androidx.cardview.widget.CardView
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                android:layout_marginEnd="6dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/user2" />
            </androidx.cardview.widget.CardView>

            <!-- 세 번째 프로필 (user3) -->
            <androidx.cardview.widget.CardView
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/user3" />
            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </LinearLayout>
</ScrollView>