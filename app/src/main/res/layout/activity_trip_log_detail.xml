<?xml version="1.0" encoding="utf-8"?>
<!--
    여행 모임 로그 — 후기 상세
    화면 묶기: triplog/TripLogDetailBinder.kt · 데이터: triplog/TripLogRepository.kt
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/log_bg"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 0. 상단 바: 뒤로 가기 + 장소 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_log_icon_button"
                android:contentDescription="뒤로 가기"
                android:src="@drawable/ic_log_back"
                android:tint="@color/log_text" />

            <TextView
                android:id="@+id/tv_toolbar_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="여행 로그"
                android:textColor="@color/log_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- 내가 쓴 후기일 때만 보인다: 수정 · 삭제 -->
            <ImageButton
                android:id="@+id/btn_edit"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_log_icon_button"
                android:contentDescription="후기 수정"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mb_edit"
                android:tint="@color/log_text"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btn_delete"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_log_icon_button"
                android:contentDescription="후기 삭제"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mb_delete"
                android:tint="@color/log_danger"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 1. 사진 — 옆으로 넘기는 슬라이드 + 오른쪽 위 1/3 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_photos"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="4dp"
            app:cardBackgroundColor="@color/log_placeholder"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/vp_photos"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/tv_photo_counter"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_gravity="top|end"
                android:layout_margin="14dp"
                android:background="@drawable/bg_log_pill_dark"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="1 / 3" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/log_primary"
                android:visibility="gone" />
        </androidx.cardview.widget.CardView>

        <!-- 2. 아래 점 표시 (지금 보는 사진 = 길쭉한 파란 점) -->
        <LinearLayout
            android:id="@+id/layout_dots"
            android:layout_width="wrap_content"
            android:layout_height="6dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="18dp">

            <!-- 3. 날짜 · 장소 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_date"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_log_chip"
                    android:drawableStart="@drawable/ic_log_calendar_small"
                    android:drawablePadding="5dp"
                    android:drawableTint="@color/log_primary"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/log_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="2026.04.11 – 04.13 · 2박 3일" />

                <TextView
                    android:id="@+id/tv_place"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_log_meta_chip"
                    android:drawableStart="@drawable/ic_log_place_small"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/log_text_sub"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/log_text_body"
                    android:textSize="13sp"
                    tools:text="시흥 거북섬" />
            </LinearLayout>

            <!-- 4. 제목 -->
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="2dp"
                android:letterSpacing="-0.02"
                android:textColor="@color/log_text"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:text="느리게 걸었던 거북섬 2박 3일" />

            <!-- 5. 별점 + 글쓴이 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 별점: 후기 쓰기 화면처럼 검은 별 ★★★★☆ -->
                <TextView
                    android:id="@+id/tv_stars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:textColor="@color/log_text"
                    android:textSize="20sp"
                    tools:text="★★★★☆" />

                <TextView
                    android:id="@+id/tv_rating_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/log_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="좋았어요" />

                <TextView
                    android:id="@+id/tv_author"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/log_text_sub"
                    android:textSize="13sp"
                    tools:text="· 나 님의 기록" />
            </LinearLayout>

            <!-- 6. 본문 -->
            <TextView
                android:id="@+id/tv_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_log_review_box"
                android:padding="16dp"
                android:lineSpacingExtra="6dp"
                android:textColor="@color/log_text_body"
                android:textIsSelectable="true"
                android:textSize="15sp"
                tools:text="빡빡한 일정 대신 자연 속에서 걷고 쉬는 것에 집중했던 여행. 복잡한 일상에서 벗어나 재충전하기에 완벽한 2박 3일이었습니다." />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="28dp"
                android:background="@color/log_line" />

            <!-- 7. 함께한 사람 — 오른쪽 아래 프로필 (누르면 정보 모달) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="16dp"
                android:paddingBottom="32dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="함께한 사람"
                        android:textColor="@color/log_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_member_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/log_text_sub"
                        android:textSize="12sp"
                        tools:text="4명 · 사진을 누르면 프로필" />
                </LinearLayout>

                <!-- 프로필 사진은 코드에서 채운다 (겹쳐 놓기, 많으면 +N) -->
                <LinearLayout
                    android:id="@+id/layout_avatars"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:gravity="center_vertical|end"
                    android:orientation="horizontal" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
