<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/diagnosisScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mb_bg"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/diagnosis_hero_background"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="28dp"
        android:paddingEnd="22dp"
        android:paddingBottom="32dp">

        <!-- 나침반 아이콘 (그림) -->
        <ImageView
            android:id="@+id/diagnosisHeroIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/diagnosis_hero_badge"
            android:contentDescription="@null"
            android:padding="12dp"
            android:src="@drawable/ic_mb_compass"
            android:tint="@color/mb_aqua_700" />

        <TextView
            android:id="@+id/diagnosisTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="-0.02"
            android:text="여행 계획 성향 진단"
            android:textColor="@color/mb_ink"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/diagnosisSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="여행할 때 나는 어떤 편인지 알려주세요."
            android:textColor="@color/mb_ink_soft"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/progressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="0 / 10 문항 응답"
            android:textColor="@color/mb_aqua_700"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/questionProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="8dp"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/diagnosis_progress" />

        <LinearLayout
            android:id="@+id/questionContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/showResultButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/mb_button_primary"
            android:enabled="false"
            android:stateListAnimator="@null"
            android:text="진단 결과 보기"
            android:textAllCaps="false"
            android:textColor="@color/mb_button_primary_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/resultContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:text="진단 결과"
                android:textColor="@color/mb_aqua_700"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/resultGreeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="나님의 성향은..."
                android:textColor="@color/mb_ink_soft"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/resultLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="균형형"
                android:letterSpacing="-0.02"
                android:textColor="@color/mb_ink"
                android:textSize="34sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/resultCard"
                android:layout_marginTop="20dp"
                android:background="@drawable/diagnosis_result_card"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:id="@+id/resultPercent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="J 50%  ·  P 50%"
                    android:textColor="@color/mb_ink"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="J · 계획형"
                        android:textColor="@color/mb_aqua_700"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="P · 유연형"
                        android:textColor="@color/mb_mint_deep"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/resultSpectrum"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:layout_marginTop="6dp"
                    android:max="1000"
                    android:progress="500"
                    android:progressDrawable="@drawable/diagnosis_spectrum" />

                <TextView
                    android:id="@+id/resultScores"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="J 점수 10 / 20 · P 점수 10 / 20"
                    android:textColor="@color/mb_ink_soft"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="동행자와 성향 비교"
                android:textColor="@color/mb_ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/companionScores"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/mb_ink_soft"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/groupSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/diagnosis_card_background"
                android:lineSpacingExtra="4dp"
                android:padding="18dp"
                android:text="동행자 진단 결과가 연결되면 성향 차이를 함께 확인할 수 있어요."
                android:textColor="@color/mb_ink_soft"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="이 결과는 여행 상황에 맞춰 자체 설계한 성향 지표이며, 공식 MBTI 검사가 아닙니다."
                android:textColor="@color/mb_muted"
                android:textSize="12sp" />

            <Button
                android:id="@+id/restartButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/mb_button_outline"
                android:stateListAnimator="@null"
                android:text="다시 진단하기"
                android:textAllCaps="false"
                android:textColor="@color/mb_aqua_700"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/continueButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/mb_button_primary"
                android:stateListAnimator="@null"
                android:text="넘어가기"
                android:textAllCaps="false"
                android:textColor="@color/mb_button_primary_text"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
