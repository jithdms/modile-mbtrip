<?xml version="1.0" encoding="utf-8"?>
<!-- XML 화면 메인 버튼 — 꺼져 있으면 회색 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/mb_field" />
            <stroke android:width="1dp" android:color="@color/mb_line" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <ripple android:color="@color/log_ripple">
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/mb_aqua_300" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
