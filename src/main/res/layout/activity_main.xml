<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 상단 영역: 뒤로 가기 버튼 + 검색바 + 달력 아이콘 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 1. 왼쪽 상단 뒤로 가기 버튼 -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginRight="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="뒤로 가기"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_revert" />

        <!-- 검색바 영역 (입력창 + 검색 아이콘) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#F5F5F5"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <!-- 검색어 입력창 -->
            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="검색어 입력"
                android:inputType="text"
                android:textColor="#333333"
                android:textColorHint="#999999"
                android:textSize="16sp" />

            <!-- 검색 아이콘 -->
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="검색"
                android:src="@android:drawable/ic_menu_search" />
        </LinearLayout>

        <!-- 2. 검색창 오른쪽 달력 아이콘 -->
        <ImageView
            android:id="@+id/ivCalendar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="기간 선택 달력"
            android:focusable="true"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_my_calendar" />
    </LinearLayout>

    <!-- 사진 그리드 영역 (스크롤뷰 - 아래로 길어지면 자연스럽게 스크롤됨) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <!-- 좌우 2개 열로 나누어 지그재그 배치 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- [왼쪽 컬럼] 사진 3장 배치 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- 왼쪽 1번 사진 -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/rounded_image"
                    android:clipToOutline="true"
                    android:contentDescription="왼쪽 사진 1"
                    android:scaleType="centerCrop"
                    android:src="@drawable/travel_main_photo" />

                <!-- 왼쪽 2번 사진 -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/rounded_image"
                    android:clipToOutline="true"
                    android:contentDescription="왼쪽 사진 2"
                    android:scaleType="centerCrop"
                    android:src="@drawable/travel_main_photo" />

                <!-- 왼쪽 3번 사진 -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/rounded_image"
                    android:clipToOutline="true"
                    android:contentDescription="왼쪽 사진 3"
                    android:scaleType="centerCrop"
                    android:src="@drawable/photo2" />
            </LinearLayout>

            <!-- [오른쪽 컬럼] 사진 2장 배치 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- 오른쪽 1번 사진 -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/rounded_image"
                    android:clipToOutline="true"
                    android:contentDescription="오른쪽 사진 1"
                    android:scaleType="centerCrop"
                    android:src="@drawable/photo1" />

                <!-- 오른쪽 2번 사진 -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="230dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/rounded_image"
                    android:clipToOutline="true"
                    android:contentDescription="오른쪽 사진 2"
                    android:scaleType="centerCrop"
                    android:src="@drawable/photo2" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>